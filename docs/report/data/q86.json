 {
  "id": "q2",
  "cat": "ORDER BY",
  "purpose": "Available ICU and ventilator beds, ordered by ward and bed number (what the emergency desk looks at first).",
  "sql": "SELECT b.bed_number, b.bed_type, w.name AS ward, w.floor\nFROM beds b JOIN wards w ON w.ward_id = b.ward_id\nWHERE b.status = 'AVAILABLE' AND b.bed_type IN ('ICU', 'VENTILATOR_ICU')\nORDER BY w.name, b.bed_number;",
