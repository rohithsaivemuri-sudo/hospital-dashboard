  "id": "q1",
  "cat": "Simple SELECT with conditions",
  "purpose": "Medicines whose stock has fallen to or below their reorder level (the low-stock alert).",
  "sql": "SELECT medicine_id, name, stock_quantity, reorder_level\nFROM medicines\nWHERE stock_quantity <= reorder_level AND requires_prescription = 1;",
