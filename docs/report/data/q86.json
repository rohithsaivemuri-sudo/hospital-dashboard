 {
  "id": "q10",
  "cat": "IN and EXISTS",
  "purpose": "Patients with an ACTIVE admission (EXISTS) who also have a lab order that is not yet completed (IN).",
  "sql": "SELECT p.patient_id, p.name\nFROM patients p\nWHERE EXISTS (SELECT 1 FROM admissions a\n              WHERE a.patient_id = p.patient_id AND a.status = 'ACTIVE')\n  AND p.patient_id IN (SELECT o.patient_id FROM lab_orders o\n                       WHERE o.status <> 'COMPLETED');",
