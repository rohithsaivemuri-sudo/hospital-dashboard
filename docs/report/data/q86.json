 {
  "id": "q9",
  "cat": "Correlated subquery",
  "purpose": "Each admitted patient with the time of their latest vital-signs reading (NULL: not taken yet). The subquery runs once per admission.",
  "sql": "SELECT p.name, a.admission_date,\n       (SELECT MAX(v.recorded_at_utc) FROM vital_signs v\n         WHERE v.admission_id = a.admission_id) AS last_vitals_utc\nFROM admissions a JOIN patients p ON p.patient_id = a.patient_id\nWHERE a.status = 'ACTIVE'\nORDER BY a.admission_date DESC\nLIMIT 6;",
  "results": [
