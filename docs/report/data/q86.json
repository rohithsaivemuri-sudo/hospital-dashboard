 {
  "id": "q4",
  "cat": "GROUP BY with HAVING",
  "purpose": "Departments that have more than one doctor, with their doctor count and combined capacity.",
  "sql": "SELECT dep.name AS department, COUNT(*) AS doctors,\n       SUM(doc.max_workload) AS capacity\nFROM doctors doc JOIN departments dep ON dep.department_id = doc.department_id\nGROUP BY dep.department_id, dep.name\nHAVING COUNT(*) > 1\nORDER BY doctors DESC, department;",
  "results": [
