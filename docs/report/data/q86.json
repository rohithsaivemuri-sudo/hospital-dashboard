 {
  "id": "q3",
  "cat": "Aggregates: COUNT, SUM, AVG, MIN, MAX",
  "purpose": "Billing summary: how many bills, how much billed and paid, and the smallest, average and largest bill.",
  "sql": "SELECT COUNT(*) AS bills, SUM(total_amount) AS billed, SUM(paid_amount) AS paid,\n       MIN(total_amount) AS smallest, ROUND(AVG(total_amount), 2) AS average,\n       MAX(total_amount) AS largest\nFROM bills;",
  "results": [
   {
    "count": 1,
    "cols": [
     "bills",
     "billed",
     "paid",
     "smallest",
     "average",
     "largest"
