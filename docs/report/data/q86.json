 {
  "id": "q8",
  "cat": "Nested query (subquery in WHERE)",
  "purpose": "Medicines priced above the average price of all medicines.",
  "sql": "SELECT name, category, unit_price\nFROM medicines\nWHERE unit_price > (SELECT AVG(unit_price) FROM medicines)\nORDER BY unit_price DESC\nLIMIT 6;",
