 {
  "id": "q6",
  "cat": "LEFT JOIN",
  "purpose": "Every doctor with the number of ACTIVE admissions they hold, including doctors with none (LEFT JOIN keeps them, COUNT gives 0).",
  "sql": "SELECT d.name, d.current_workload, d.max_workload,\n       COUNT(a.admission_id) AS active_admissions\nFROM doctors d\nLEFT JOIN admissions a ON a.doctor_id = d.doctor_id AND a.status = 'ACTIVE'\nGROUP BY d.doctor_id, d.name, d.current_workload, d.max_workload\nORDER BY active_admissions DESC, d.name\nLIMIT 6;",
  "results": [
