 {
  "id": "q13",
  "cat": "Business question: bed occupancy",
  "purpose": "Occupancy by bed type: how full is the hospital? (CASE inside SUM.)",
  "sql": "SELECT bed_type, COUNT(*) AS beds,\n       SUM(status = 'OCCUPIED') AS occupied,\n       ROUND(100 * SUM(status = 'OCCUPIED') / COUNT(*), 1) AS occupancy_pct\nFROM beds\nGROUP BY bed_type\nORDER BY occupancy_pct DESC;",
  "results": [
