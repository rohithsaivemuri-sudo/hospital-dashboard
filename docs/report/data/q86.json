 {
  "id": "q12",
  "cat": "Multiple tables (five-table join)",
  "purpose": "Current inpatients with ward, bed, admitting doctor and department.",
  "sql": "SELECT p.name AS patient, w.name AS ward, b.bed_number,\n       d.name AS doctor, dep.name AS department\nFROM admissions a\nJOIN patients p      ON p.patient_id = a.patient_id\nJOIN beds b          ON b.bed_id = a.bed_id\nJOIN wards w         ON w.ward_id = b.ward_id\nJOIN doctors d       ON d.doctor_id = a.doctor_id\nJOIN departments dep ON dep.department_id = a.department_id\nWHERE a.status = 'ACTIVE'\nORDER BY w.name, b.bed_number\nLIMIT 6;",
  "results": [
   {
    "count": 6,
    "cols": [
     "patient",
     "ward",
     "bed_number",
     "doctor",
