{
  "name": "hospital-dashboard-server",
  "version": "1.0.0",
  "description": "Real-Time Smart Hospital Management and Emergency Resource Allocation System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 --test-global-setup=tests/global-setup.js \"tests/**/*.test.js\"",
    "test:stress": "node tests/stress/dispense.stress.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --dry-run",
    "db:test:rebuild": "node scripts/test-db.js",
    "db:schema-diff": "node scripts/schema-diff.js",
    "demo:reset": "node scripts/demo-reset.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.6.1",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
