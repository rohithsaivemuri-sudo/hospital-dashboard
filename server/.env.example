# Copy to server/.env (git-ignored) and fill in. Never commit real values.

# --- Database: the running app (restricted account, see docs/mysql-app-user.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hospital_db
# The app refuses to start if DB_USER is root.
DB_USER=hospital_app
# MySQL generates this when you run docs/mysql-app-user.sql (IDENTIFIED BY RANDOM PASSWORD).
DB_PASSWORD=change-me

# --- Database: administrative account (migrations, backups, schema diff, test database) ---
# Not used by the running app.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=change-me

# --- App ---
PORT=5000
# Signs login tokens. Use a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me
# Browser origin allowed by CORS (the Vite dev server in development).
CLIENT_URL=http://localhost:5173
# Where uploaded lab reports are stored (default: server/uploads/lab-reports).
LAB_REPORT_DIR=

# --- Tests only (optional) ---
# Port for the API server the test suite starts (default 5099).
TEST_PORT=
# Test database name; must end in _test (default hospital_db_test).
TEST_DB_NAME=
# Rounds per scenario for npm run test:stress (default 300).
STRESS_ROUNDS=
