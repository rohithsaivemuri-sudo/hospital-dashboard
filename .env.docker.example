# For docker compose: copy to .env (git-ignored) in the repository root and fill in.
# Generate each secret with: openssl rand -base64 32   (JWT_SECRET: openssl rand -base64 48)
MYSQL_ROOT_PASSWORD=change-me
# Password for the restricted app account (hospital_app), created on first start.
DB_PASSWORD=change-me
JWT_SECRET=change-me
# Public address of the app (CORS and sockets allow only this origin).
CLIENT_URL=http://localhost:8080
# Host port, bound to 127.0.0.1.
APP_PORT=8080
# Number of reverse proxies in front of the app (e.g. 1), or empty.
TRUST_PROXY=
